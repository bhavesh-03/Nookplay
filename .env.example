SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional SMTP bug reports. Keep these values on the server only.
# Resend free SMTP: host smtp.resend.com, port 465, user resend, password your API key.
# A verified sender address is required for production delivery.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM="Nookplay <bugs@your-verified-domain.com>"
BUG_REPORT_TO=you@example.com
