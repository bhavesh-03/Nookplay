SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional SMTP bug reports. Keep these values on the server only.
# Gmail: enable 2-Step Verification and use a Google app password.
# For Resend, use smtp.resend.com, user resend, and an API key as password.
# A verified sender address is required for production delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM="Nookplay <your-address@gmail.com>"
BUG_REPORT_TO=your-address@gmail.com
